<icegrid>
    <application name="Spotifice">

        <server-template id="MediaServerTemplate">
            <parameter name="id"/>
            <server id="MediaServer${id}" activation="on-demand" exe="./media_server.py">
                <distrib icepatch="${application}.IcePatch2/server:tcp -h 0.0.0.0 -p 4064"/>
                <adapter name="MediaServerAdapter" endpoints="default">
                    <object identity="MediaServer${id}" type="::Spotifice::MediaServer"/>
                </adapter>
                <property name="MediaServer.Content" value="media"/>
                <property name="MediaServer.Playlists" value="playlists"/>
                <property name="MediaServer.Identity" value="MediaServer${id}"/>
            </server>
        </server-template>

        <server-template id="MediaRenderTemplate">
            <parameter name="id"/>
            <server id="MediaRender${id}" activation="on-demand" exe="./media_render.py">
                <distrib icepatch="${application}.IcePatch2/server:tcp -h 0.0.0.0 -p 4064"/>
                <adapter name="MediaRenderAdapter" endpoints="default">
                    <object identity="MediaRender${id}" type="::Spotifice::MediaRender"/>
                </adapter>
                <property name="MediaRender.Identity" value="MediaRender${id}"/>
            </server>
        </server-template>

        <server-template id="IceStormTemplate">
            <icebox id="IceStorm" activation="always" exe="icebox">
                <service name="IceStorm" entry="IceStormService,37:createIceStorm">
                    <!-- CRITICAL: Explicit endpoints with host and ports -->
                    <adapter name="IceStorm.TopicManager" 
                             endpoints="tcp -h 127.0.0.1 -p 9999"/>
                    
                    <adapter name="IceStorm.Publish" 
                             endpoints="tcp -h 127.0.0.1 -p 9998"/>
                    
                    <adapter name="IceStorm.Node" 
                             endpoints="tcp -h 127.0.0.1"/>
                    
                    <!-- Properties for reliable endpoint registration -->
                    <property name="IceStorm.LMDB.Path" value="db/icestorm"/>
                    <property name="IceStorm.InstanceName" value="SpotificeIceStorm"/>
                    
                    <!-- CRITICAL: Enable endpoint dissemination -->
                    <property name="Ice.PrintAdapterReady" value="1"/>
                    <property name="IceStorm.Transient.TopicManager.AdapterId" 
                              value="IceStorm.TopicManager"/>
                    <property name="IceStorm.Transient.Publish.AdapterId" 
                              value="IceStorm.Publish"/>
                </service>
            </icebox>
        </server-template>

        <node name="node1">
            <server-instance template="IceStormTemplate"/>
            <server-instance template="MediaServerTemplate" id="1"/>
            <server-instance template="MediaRenderTemplate" id="1"/>
        </node>

        <node name="node2">
            <server-instance template="MediaServerTemplate" id="2"/>
            <server-instance template="MediaRenderTemplate" id="2"/>
        </node>

    </application>
</icegrid>