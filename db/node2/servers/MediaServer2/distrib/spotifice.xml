<icegrid>
    <application name="Spotifice">

        <server-template id="MediaServerTemplate">
            <parameter name="id"/>
            <server id="MediaServer${id}" activation="on-demand" exe="./media_server.py">
                <distrib icepatch="${application}.IcePatch2/server:tcp -h localhost -p 4064"/>
                
                <adapter name="MediaServerAdapter" endpoints="default">
                    <object identity="MediaServer${id}" type="::Spotifice::MediaServer"/>
                </adapter>
                <property name="MediaServer.Content" value="media"/>
                <property name="MediaServer.Playlists" value="playlists"/>
                <property name="MediaServer.Identity" value="MediaServer${id}"/>
            </server>
        </server-template>

        <server-template id="MediaRenderTemplate">
            <parameter name="id"/>
            <server id="MediaRender${id}" activation="on-demand" exe="./media_render.py">
                <distrib icepatch="${application}.IcePatch2/server:tcp -h localhost -p 4064"/>
                
                <adapter name="MediaRenderAdapter" endpoints="default">
                    <object identity="MediaRender${id}" type="::Spotifice::MediaRender"/>
                </adapter>
                <property name="MediaRender.Identity" value="MediaRender${id}"/>
            </server>
        </server-template>

        <node name="node1">
            <server-instance template="MediaServerTemplate" id="1"/>
            <server-instance template="MediaRenderTemplate" id="1"/>
        </node>

        <node name="node2">
            <server-instance template="MediaServerTemplate" id="2"/>
            <server-instance template="MediaRenderTemplate" id="2"/>
        </node>

    </application>
</icegrid>